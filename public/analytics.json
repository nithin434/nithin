{
  "name": "Nithin Jambula Portfolio Analytics",
  "version": "1.0.0",
  "description": "Performance and analytics configuration for portfolio website",
  "analytics": {
    "google": {
      "ga4": "",
      "gtm": "",
      "search_console": ""
    },
    "microsoft": {
      "clarity": "",
      "bing_webmaster": ""
    },
    "social": {
      "facebook_pixel": "",
      "linkedin_insight": ""
    }
  },
  "performance": {
    "core_web_vitals": true,
    "real_user_monitoring": true,
    "speed_index_target": 1.5,
    "lcp_target": 2.5,
    "fid_target": 100,
    "cls_target": 0.1
  },
  "seo": {
    "structured_data": true,
    "open_graph": true,
    "twitter_cards": true,
    "meta_optimization": true,
    "sitemap": true,
    "robots_txt": true
  },
  "accessibility": {
    "wcag_level": "AA",
    "keyboard_navigation": true,
    "screen_reader_support": true,
    "color_contrast": "AAA"
  },
  "security": {
    "https_enforced": true,
    "security_headers": true,
    "content_security_policy": true,
    "privacy_compliance": "GDPR"
  }
}